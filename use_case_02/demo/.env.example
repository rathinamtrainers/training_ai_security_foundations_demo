# UC2 optional overrides. Copy to .env for local use (.env is git-ignored).
# No secrets live here. The only "secret" in the whole lab, INTERNAL_KEY, is a
# fake marker seeded inside RedVault and is never placed in any file in this folder.

# Base URL of the running RedVault API (used by the live extraction harvest).
REDVAULT_API=http://localhost:8000

# Path to RedVault's vector store that `make seed` writes. The default resolves
# to ../../../src/data/redvault.db; override only if your store lives elsewhere.
# REDVAULT_DB_PATH=

# Posture the inversion demo reflects. Leave unset (vulnerable) for UC2's attack.
# Set to hardened only to SEE the UC9 tenant-isolation control deny the cross-tenant read.
# REDVAULT_MODE=vulnerable
