# UC3 talks to the RUNNING RedVault API over plain HTTP. Copy to .env only if you
# need to override the default. No secret goes in here — RedVault's INTERNAL_KEY is
# a fake marker seeded inside the app, and this demo never contains its value.

# Base URL of the running RedVault API. Default matches the live stack on :8000.
REDVAULT_API=http://localhost:8000
