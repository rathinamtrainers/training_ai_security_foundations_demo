# UC1 optional overrides. Copy to .env for local use (.env is git-ignored).
# No secrets live here: UC1 reads no token. INTERNAL_KEY is a fake marker seeded
# inside RedVault and is never placed in any file in this folder.

# Base URL of the running RedVault API.
REDVAULT_API=http://localhost:8000

# (Jailbreak sweep only) interpreter that has garak 0.15.1 installed.
GARAK_PYTHON=../../../src/.venv/bin/python

# (Report reader, optional) directory to search for the newest garak report.
# GARAK_RUN_DIR=
