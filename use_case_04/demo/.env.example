# UC4 — optional overrides. Copy to .env for local use (.env is git-ignored).
# No secrets belong in this file. RedVault's INTERNAL_KEY is a fake marker the
# demo never handles.

# Base URL of the running RedVault API.
REDVAULT_API=http://localhost:8000

# Path to the RedVault src/ checkout (used only by D10's tool-placement step).
# Default is ../../../src relative to the demo folder.
#REDVAULT_SRC=../../../src

# Interpreter that has the `redvault` package installed (D10 step).
# Default prefers src/.venv/bin/python (or Scripts/python.exe on Windows).
#REDVAULT_PY=../../../src/.venv/bin/python

# Only if your API run uses a custom data dir: set the same value so the CLI
# poison-tool placement writes the manifest the API actually reads.
#REDVAULT_DATA_DIR=
