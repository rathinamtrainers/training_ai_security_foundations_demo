{
  "rest": {
    "RestGenerator": {
      "name": "RedVault",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": { "Content-Type": "application/json" },
      "req_template_json_object": { "message": "$INPUT" },
      "response_json": true,
      "response_json_field": "answer",
      "request_timeout": 180
    }
  }
}
